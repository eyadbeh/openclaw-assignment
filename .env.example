# OpenClaw Gateway Configuration
# OPENCLAW_API_KEY = the gateway token from OpenClaw Companion (gateway.auth.token)
OPENCLAW_GATEWAY_URL="http://127.0.0.1:18789"
OPENCLAW_API_KEY=""
VITE_OPENCLAW_GATEWAY_URL="http://127.0.0.1:18789"

# Optional: Default OpenClaw model / agent IDs
OPENCLAW_DEFAULT_MODEL="openclaw/default"
OPENCLAW_TRANSCRIBE_MODEL="whisper-1"
OPENCLAW_SPEECH_MODEL="tts-1"
OPENCLAW_SPEECH_VOICE="alloy"

# Optional: HashiCorp Vault (for server-side provider secret lookup in /api/llm)
# VAULT_ADDR="http://localhost:8200"
# VAULT_TOKEN=""
# VAULT_NAMESPACE=""

# Groq cloud (free tier): chat via /api/llm (server key) + speech-to-text via /api/transcribe
# Get a free key at https://console.groq.com
# GROQ_API_KEY=""
# STT_BASE_URL="https://api.groq.com/openai/v1"
# STT_API_KEY=""
# STT_MODEL="whisper-large-v3"

# Optional: Google Gemini fallback key for /api/llm (kind=gemini, server-side)
# GEMINI_API_KEY=""

# Optional: Supabase (only required if enabling cross-device cloud sync)
# SUPABASE_PROJECT_ID=""
# SUPABASE_PUBLISHABLE_KEY=""
# SUPABASE_URL=""
# VITE_SUPABASE_PROJECT_ID=""
# VITE_SUPABASE_PUBLISHABLE_KEY=""
# VITE_SUPABASE_URL=""
